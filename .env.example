# Input data paths for the COVID-19 mobility study pipeline.
#
# The real .env lives at the project root and is gitignored; this file is a
# template. src/index.R loads it with dotenv::load_dot_env() and resolves
# relative paths against the directory containing the .env file, so absolute
# paths are recommended.
#
# 2021 online survey, all channels except mail-back (.rds file):
DATA_2021_PATH=/path/to/altogether_cleaned.rds
# Mail-out / mail-back survey (.sav file):
DATA_MM_PATH=/path/to/mm.sav
